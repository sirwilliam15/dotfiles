{
  "manifest_version": 2,
  "name": "Nord Everforest Blend",
  "version": "1.0",
  "description": "Nord Polar Night backgrounds with Everforest accent colors.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nord-everforest-blend@will.dotfiles"
    }
  },
  "theme": {
    "colors": {
      "frame":                       "#2e3440",
      "frame_inactive":              "#2e3440",

      "toolbar":                     "#3b4252",
      "toolbar_top_separator":       "#2e3440",
      "toolbar_bottom_separator":    "#434c5e",
      "toolbar_vertical_separator":  "#434c5e",

      "toolbar_text":                "#d3c6aa",
      "bookmark_text":               "#d3c6aa",
      "icons":                       "#d3c6aa",
      "icons_attention":             "#83c092",

      "toolbar_field":               "#434c5e",
      "toolbar_field_text":          "#d3c6aa",
      "toolbar_field_border":        "#434c5e",
      "toolbar_field_focus":         "#434c5e",
      "toolbar_field_text_focus":    "#e5e9f0",
      "toolbar_field_border_focus":  "#83c092",
      "toolbar_field_highlight":     "#83c092",
      "toolbar_field_highlight_text":"#2e3440",

      "tab_text":                    "#d3c6aa",
      "tab_background_text":         "#7a8478",
      "tab_selected":                "#434c5e",
      "tab_line":                    "#83c092",
      "tab_loading":                 "#7fbbb3",
      "tab_background_separator":    "#2e3440",

      "button_background_hover":     "#434c5e",
      "button_background_active":    "#a7c080",

      "popup":                       "#3b4252",
      "popup_text":                  "#d3c6aa",
      "popup_border":                "#4c566a",
      "popup_highlight":             "#434c5e",
      "popup_highlight_text":        "#e5e9f0",

      "sidebar":                     "#3b4252",
      "sidebar_text":                "#d3c6aa",
      "sidebar_border":              "#4c566a",
      "sidebar_highlight":           "#83c092",
      "sidebar_highlight_text":      "#2e3440",

      "ntp_background":              "#2e3440",
      "ntp_text":                    "#d3c6aa"
    },
    "properties": {
      "color_scheme":          "dark",
      "content_color_scheme":  "dark"
    }
  }
}
