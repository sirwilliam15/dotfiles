{
  "$schema": "vscode://schemas/color-theme",
  "name": "PlayStation Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#101114",
    "editor.foreground": "#d8d8dc",
    "editor.lineHighlightBackground": "#181a1f",
    "editor.selectionBackground": "#33415580",
    "editor.selectionHighlightBackground": "#33415555",
    "editor.wordHighlightBackground": "#34394466",
    "editor.wordHighlightStrongBackground": "#6f96c740",
    "editor.findMatchBackground": "#ffd16655",
    "editor.findMatchHighlightBackground": "#6f96c738",
    "editor.hoverHighlightBackground": "#24283280",
    "editor.inactiveSelectionBackground": "#2b303a70",

    "editorCursor.foreground": "#f0f0f2",
    "editorWhitespace.foreground": "#343944",
    "editorIndentGuide.background": "#343944",
    "editorIndentGuide.background1": "#343944",
    "editorIndentGuide.activeBackground": "#6f96c7",
    "editorIndentGuide.activeBackground1": "#6f96c7",
    "editorLineNumber.foreground": "#858a96",
    "editorLineNumber.activeForeground": "#ffd166",
    "editorBracketMatch.background": "#343944aa",
    "editorBracketMatch.border": "#ff8fcb",

    "editorError.foreground": "#ff5f6d",
    "editorWarning.foreground": "#ffd166",
    "editorInfo.foreground": "#6ba7bf",
    "editorHint.foreground": "#8497c5",

    "editorGutter.addedBackground": "#56d68a",
    "editorGutter.modifiedBackground": "#6f96c7",
    "editorGutter.deletedBackground": "#ff5f6d",

    "editorOverviewRuler.errorForeground": "#ff5f6d",
    "editorOverviewRuler.warningForeground": "#ffd166",
    "editorOverviewRuler.infoForeground": "#6ba7bf",

    "editorWidget.background": "#181a1f",
    "editorWidget.border": "#343944",
    "editorSuggestWidget.background": "#181a1f",
    "editorSuggestWidget.border": "#343944",
    "editorSuggestWidget.selectedBackground": "#242832",
    "editorSuggestWidget.highlightForeground": "#ff8fcb",
    "editorCodeLens.foreground": "#9ea2ad",
    "editorInlayHint.foreground": "#9ea2ad",
    "editorInlayHint.background": "#24283280",

    "tab.activeBackground": "#101114",
    "tab.activeForeground": "#f0f0f2",
    "tab.activeBorderTop": "#4aa3ff",
    "tab.inactiveBackground": "#181a1f",
    "tab.inactiveForeground": "#8a8f9c",
    "tab.border": "#101114",

    "activityBar.background": "#101114",
    "activityBar.foreground": "#d8d8dc",
    "activityBar.inactiveForeground": "#8a8f9c",
    "activityBarBadge.background": "#4aa3ff",
    "activityBarBadge.foreground": "#101114",

    "sideBar.background": "#181a1f",
    "sideBar.foreground": "#d8d8dc",
    "sideBar.border": "#101114",
    "sideBarTitle.foreground": "#f0f0f2",
    "sideBarSectionHeader.background": "#242832",
    "sideBarSectionHeader.foreground": "#d8d8dc",

    "list.activeSelectionBackground": "#28384d",
    "list.activeSelectionForeground": "#f0f0f2",
    "list.hoverBackground": "#242832",
    "list.inactiveSelectionBackground": "#242832",
    "list.highlightForeground": "#779dcc",
    "list.errorForeground": "#ff6b7a",
    "list.warningForeground": "#ffd166",

    "titleBar.activeBackground": "#101114",
    "titleBar.activeForeground": "#f0f0f2",
    "titleBar.inactiveBackground": "#101114",
    "titleBar.inactiveForeground": "#8a8f9c",

    "statusBar.background": "#181a1f",
    "statusBar.foreground": "#d8d8dc",
    "statusBar.border": "#101114",
    "statusBar.debuggingBackground": "#ff8fcb",
    "statusBar.debuggingForeground": "#101114",
    "statusBar.noFolderBackground": "#181a1f",
    "statusBarItem.remoteBackground": "#0057b8",
    "statusBarItem.remoteForeground": "#f0f0f2",

    "panel.background": "#181a1f",
    "panel.border": "#343944",
    "panelTitle.activeBorder": "#4aa3ff",
    "panelTitle.activeForeground": "#f0f0f2",
    "panelTitle.inactiveForeground": "#8a8f9c",

    "terminal.background": "#101114",
    "terminal.foreground": "#d8d8dc",
    "terminal.ansiBlack": "#181a1f",
    "terminal.ansiRed": "#ff5f6d",
    "terminal.ansiGreen": "#56d68a",
    "terminal.ansiYellow": "#ffd166",
    "terminal.ansiBlue": "#4aa3ff",
    "terminal.ansiMagenta": "#ff8fcb",
    "terminal.ansiCyan": "#5ad6ff",
    "terminal.ansiWhite": "#d8d8dc",
    "terminal.ansiBrightBlack": "#9ea2ad",
    "terminal.ansiBrightRed": "#ff7a89",
    "terminal.ansiBrightGreen": "#6ee7a8",
    "terminal.ansiBrightYellow": "#ffe08a",
    "terminal.ansiBrightBlue": "#7cb7ff",
    "terminal.ansiBrightMagenta": "#c792ea",
    "terminal.ansiBrightCyan": "#64d8cb",
    "terminal.ansiBrightWhite": "#f0f0f2",

    "breadcrumb.foreground": "#9ea2ad",
    "breadcrumb.focusForeground": "#f0f0f2",
    "breadcrumb.activeSelectionForeground": "#f0f0f2",

    "input.background": "#181a1f",
    "input.foreground": "#d8d8dc",
    "input.border": "#343944",
    "input.placeholderForeground": "#9ea2ad",
    "inputOption.activeBorder": "#4aa3ff",

    "dropdown.background": "#181a1f",
    "dropdown.foreground": "#d8d8dc",
    "dropdown.border": "#343944",

    "button.background": "#0057b8",
    "button.foreground": "#f0f0f2",
    "button.hoverBackground": "#0b62c4",

    "badge.background": "#4aa3ff",
    "badge.foreground": "#101114",

    "scrollbar.shadow": "#00000040",
    "scrollbarSlider.background": "#4b505c30",
    "scrollbarSlider.hoverBackground": "#4b505c50",
    "scrollbarSlider.activeBackground": "#4b505c70",

    "minimap.findMatchHighlight": "#ffd16655",
    "minimap.selectionHighlight": "#33415580",
    "minimap.errorHighlight": "#ff5f6d",
    "minimap.warningHighlight": "#ffd166",

    "gitDecoration.addedResourceForeground": "#6ee7a8",
    "gitDecoration.modifiedResourceForeground": "#779dcc",
    "gitDecoration.deletedResourceForeground": "#ff7a89",
    "gitDecoration.untrackedResourceForeground": "#719e9a",
    "gitDecoration.ignoredResourceForeground": "#8a8f9c99",
    "gitDecoration.conflictingResourceForeground": "#ff8fcb",
    "gitDecoration.renamedResourceForeground": "#ffd166",
    "gitDecoration.stageModifiedResourceForeground": "#779dcc",
    "gitDecoration.stageDeletedResourceForeground": "#ff7a89",
    "gitDecoration.submoduleResourceForeground": "#9ea2ad",

    "diffEditor.insertedLineBackground": "#133d2a66",
    "diffEditor.removedLineBackground": "#4a162066",
    "diffEditor.insertedTextBackground": "#2f8f5f80",
    "diffEditor.removedTextBackground": "#bf304580",
    "diffEditorGutter.insertedLineBackground": "#56d68a40",
    "diffEditorGutter.removedLineBackground": "#ff5f6d40",
    "diffEditorOverview.insertedForeground": "#56d68a",
    "diffEditorOverview.removedForeground": "#ff5f6d",
    "diffEditor.border": "#343944",
    "diffEditor.diagonalFill": "#4b505c40",

    "peekView.border": "#4aa3ff",
    "peekViewEditor.background": "#181a1f",
    "peekViewEditor.matchHighlightBackground": "#ffd16640",
    "peekViewResult.background": "#101114",
    "peekViewResult.fileForeground": "#d8d8dc",
    "peekViewResult.matchHighlightBackground": "#ffd16640",
    "peekViewTitle.background": "#181a1f",
    "peekViewTitleDescription.foreground": "#9ea2ad",
    "peekViewTitleLabel.foreground": "#f0f0f2",

    "merge.currentHeaderBackground": "#1e6b4a70",
    "merge.currentContentBackground": "#12372450",
    "merge.incomingHeaderBackground": "#1e5f9470",
    "merge.incomingContentBackground": "#17324d55",
    "merge.commonHeaderBackground": "#4b505c70",
    "merge.commonContentBackground": "#24283255",
    "merge.border": "#4aa3ff",
    "mergeEditor.change.background": "#17324d55",
    "mergeEditor.change.word.background": "#1d5f9480",
    "mergeEditor.conflict.unhandledUnfocused.border": "#ff8fcb99",
    "mergeEditor.conflict.unhandledFocused.border": "#ff8fcb",
    "mergeEditor.conflict.handledUnfocused.border": "#56d68a80",
    "mergeEditor.conflict.handledFocused.border": "#56d68a",
    "mergeEditor.conflict.handled.minimapOverViewRuler": "#56d68a",
    "mergeEditor.conflict.unhandled.minimapOverViewRuler": "#ff8fcb",
    "mergeEditor.conflictingLines.background": "#4a162066",

    "focusBorder": "#4aa3ff",
    "foreground": "#d8d8dc",
    "widget.shadow": "#00000040",
    "selection.background": "#33415580",
    "descriptionForeground": "#9ea2ad",
    "icon.foreground": "#4aa3ff",

    "notificationCenterHeader.background": "#181a1f",
    "notifications.background": "#181a1f",
    "notifications.border": "#343944",
    "notificationsErrorIcon.foreground": "#ff5f6d",
    "notificationsWarningIcon.foreground": "#ffd166",
    "notificationsInfoIcon.foreground": "#6ba7bf"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#9ea2ad", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#56d68a" }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#ff8fcb" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#c792ea" }
    },
    {
      "name": "Booleans & constants",
      "scope": ["constant.language", "constant.other"],
      "settings": { "foreground": "#c792ea" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#ff5f6d" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#ff8fcb" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": { "foreground": "#6ba7bf", "fontStyle": "bold" }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#d8d8dc" }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#ffd166" }
    },
    {
      "name": "Interfaces & type params",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.parameter"
      ],
      "settings": { "foreground": "#ffd166", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#d8d8dc" }
    },
    {
      "name": "Variable builtin (this/self)",
      "scope": ["variable.language"],
      "settings": { "foreground": "#8497c5" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": { "foreground": "#779dcc" }
    },
    {
      "name": "Imports & modules",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "meta.import entity.name"
      ],
      "settings": { "foreground": "#6f96c7" }
    },
    {
      "name": "Preprocessor / includes",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "punctuation.definition.directive"
      ],
      "settings": { "foreground": "#6f96c7" }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": { "foreground": "#ff6b7a" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#ff8fcb" }
    },
    {
      "name": "Decorators / annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "meta.annotation"
      ],
      "settings": { "foreground": "#719e9a" }
    },
    {
      "name": "Punctuation & brackets",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": { "foreground": "#d8d8dc" }
    },
    {
      "name": "Delimiters (commas, semicolons)",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#9ea2ad" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#719e9a" }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": { "foreground": "#6f96c7", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#6ba7bf", "fontStyle": "underline" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#6ee7a8" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#6ee7a8" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff7a89" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#779dcc" }
    },
    {
      "name": "JSON property",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#779dcc" }
    },
    {
      "name": "YAML key",
      "scope": ["entity.name.tag.yaml"],
      "settings": { "foreground": "#779dcc" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#6ba7bf" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#779dcc" }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.property-value.css"],
      "settings": { "foreground": "#c792ea" }
    },
    {
      "name": "TODO",
      "scope": ["keyword.todo", "keyword.other.todo"],
      "settings": { "foreground": "#ffd166", "fontStyle": "bold" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": { "foreground": "#6ba7bf", "bold": true },
    "method": { "foreground": "#6ba7bf" },
    "variable": { "foreground": "#d8d8dc" },
    "variable.readonly": { "foreground": "#c792ea" },
    "parameter": { "foreground": "#d8d8dc" },
    "property": { "foreground": "#779dcc" },
    "type": { "foreground": "#ffd166" },
    "interface": { "foreground": "#ffd166", "italic": true },
    "enum": { "foreground": "#ffd166" },
    "enumMember": { "foreground": "#c792ea" },
    "namespace": { "foreground": "#6f96c7" },
    "decorator": { "foreground": "#719e9a" },
    "macro": { "foreground": "#6f96c7" }
  }
}
